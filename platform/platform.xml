<?xml version='1.0'?>
<!DOCTYPE platform SYSTEM "https://simgrid.org/simgrid.dtd">
<platform version="4.1">
<zone id="world" routing="Flynn">
   <zone id="core_services" routing="Full">

      <host id="database_server" speed="100Gf"/>
      <host id="alert_server" speed="10Gf"/>
      <host id="core_router" speed="1Gf"/> 

      <link id="core_intra_link" bandwidth="100Gbps" latency="0.1ms"/>

      <route src="database_server" dst="core_router">
         <link_ctn id="core_intra_link"/>
      </route>
      <route src="alert_server" dst="core_router">
         <link_ctn id="core_intra_link"/>
      </route>

    </zone>

   <zone id="zone_1" routing="Full">

      <host id="z1_camera_host_1" speed="1Gf"/>
      <host id="z1_camera_host_2" speed="1Gf"/>
      <host id="z1_camera_host_3" speed="1Gf"/>
      <host id="z1_camera_host_4" speed="1Gf"/>

      <host id="z1_processing_node_1" speed="10Tf"/>
      <host id="z1_processing_node_2" speed="10Tf"/>
      <host id="z1_processing_node_3" speed="10Tf"/>
      <host id="z1_processing_node_4" speed="10Tf"/>

      <host id="z1_router" speed="1Gf"/> 

      <link id="z1_intra_link" bandwidth="1Gbps" latency="1ms"/>

      <route src="z1_camera_host_1" dst="z1_router">
         <link_ctn id="z1_intra_link"/>
      </route>
      <route src="z1_camera_host_2" dst="z1_router">
         <link_ctn id="z1_intra_link"/>
      </route>
      <route src="z1_camera_host_3" dst="z1_router">
         <link_ctn id="z1_intra_link"/>
      </route>
      <route src="z1_camera_host_4" dst="z1_router">
         <link_ctn id="z1_intra_link"/>
      </route>

      <route src="z1_processing_node_1" dst="z1_router">
         <link_ctn id="z1_intra_link"/>
      </route>
      <route src="z1_processing_node_2" dst="z1_router">
         <link_ctn id="z1_intra_link"/>
      <route src="z1_processing_node_3" dst="z1_router">
         <link_ctn id="z1_intra_link"/>
      </route>      
      <route src="z1_processing_node_4" dst="z1_router">
         <link_ctn id="z1_intra_link"/>
      </route>

      <route src="z1_camera_host_1" dst="z1_proc1">
         <link_ctn id="z1_intra_link"/>
      </route>
      <route src="z1_camera_host_2" dst="z1_proc2">
         <link_ctn id="z1_intra_link"/>
      </route>
      <route src="z1_camera_host_3" dst="z1_proc3">
         <link_ctn id="z1_intra_link"/>
      </route>
      <route src="z1_camera_host_4" dst="z1_proc4">
         <link_ctn id="z1_intra_link"/>
      </route>
   </zone>

   <link id="bb_z1_core" bandwidth="10Gbps" latency="5ms"/>

   <zoneRoute src="zone1" dst="core_zone" gw_src="z1_router" gw_dst="core_router"><link_ctn id="bb_z1_core"/></zoneRoute>
</zone>
</platform>


<?xml version='1.0'?>
<!DOCTYPE platform SYSTEM "https://simgrid.org/simgrid.dtd">
<platform version="4.1">

  <zone id="world" routing="Floyd">

    <zone id="core_services" routing="Full">
      <!-- Hosts -->
      <host id="database_server" speed="100Gf"/>
      <host id="alert_server" speed="10Gf"/>
      <host id="core_router" speed="1Gf"/> 

      <!-- Links -->
      <link id="core_intra_link" bandwidth="100Gbps" latency="0.1ms"/>

      <!-- Routes -->
      <route src="database_server" dst="core_router"> <link_ctn id="core_intra_link"/> </route>
      <route src="alert_server"    dst="core_router"> <link_ctn id="core_intra_link"/> </route>
    </zone> 

    <zone id="zone_1" routing="Full">
      <!-- Hosts -->
      <host id="z1_router" speed="1Gf"/> 
      <host id="z1_camera_host_1" speed="1Gf"/>
      <host id="z1_camera_host_2" speed="1Gf"/>
      <host id="z1_camera_host_3" speed="1Gf"/>
      <host id="z1_camera_host_4" speed="1Gf"/>
      <host id="z1_cpu_node_1" speed="500Gf"/>
      <host id="z1_accelerator_od_1" speed="8Tf"/>
      <host id="z1_accelerator_fr_1" speed="5Tf"/>
      <host id="z1_cpu_node_2" speed="500Gf"/>
      <host id="z1_accelerator_od_2" speed="8Tf"/>
      <host id="z1_accelerator_fr_2" speed="5Tf"/>
      <host id="z1_cpu_node_3" speed="500Gf"/>
      <host id="z1_accelerator_od_3" speed="8Tf"/>
      <host id="z1_accelerator_fr_3" speed="5Tf"/>
      <host id="z1_cpu_node_4" speed="500Gf"/>
      <host id="z1_accelerator_od_4" speed="8Tf"/>
      <host id="z1_accelerator_fr_4" speed="5Tf"/>

      <!-- Links -->
      <link id="z1_intra_link" bandwidth="1Gbps" latency="1ms"/>
      <link id="z1_pcie_cpu1_od1" bandwidth="256Gbps" latency="0.5us"/>
      <link id="z1_pcie_cpu1_fr1" bandwidth="256Gbps" latency="0.5us"/>
      <link id="z1_pcie_cpu2_od2" bandwidth="256Gbps" latency="0.5us"/>
      <link id="z1_pcie_cpu2_fr2" bandwidth="256Gbps" latency="0.5us"/>
      <link id="z1_pcie_cpu3_od3" bandwidth="256Gbps" latency="0.5us"/>
      <link id="z1_pcie_cpu3_fr3" bandwidth="256Gbps" latency="0.5us"/>
      <link id="z1_pcie_cpu4_od4" bandwidth="256Gbps" latency="0.5us"/>
      <link id="z1_pcie_cpu4_fr4" bandwidth="256Gbps" latency="0.5us"/>

      <!-- Routes -->
      <route src="z1_camera_host_1" dst="z1_router"> <link_ctn id="z1_intra_link"/> </route>
      <route src="z1_camera_host_2" dst="z1_router"> <link_ctn id="z1_intra_link"/> </route>
      <route src="z1_camera_host_3" dst="z1_router"> <link_ctn id="z1_intra_link"/> </route>
      <route src="z1_camera_host_4" dst="z1_router"> <link_ctn id="z1_intra_link"/> </route>
      <route src="z1_cpu_node_1" dst="z1_router"> <link_ctn id="z1_intra_link"/> </route>
      <route src="z1_cpu_node_2" dst="z1_router"> <link_ctn id="z1_intra_link"/> </route>
      <route src="z1_cpu_node_3" dst="z1_router"> <link_ctn id="z1_intra_link"/> </route>
      <route src="z1_cpu_node_4" dst="z1_router"> <link_ctn id="z1_intra_link"/> </route>
      <route src="z1_cpu_node_1" dst="z1_accelerator_od_1"> <link_ctn id="z1_pcie_cpu1_od1"/> </route>
      <route src="z1_cpu_node_1" dst="z1_accelerator_fr_1"> <link_ctn id="z1_pcie_cpu1_fr1"/> </route>
      <route src="z1_cpu_node_2" dst="z1_accelerator_od_2"> <link_ctn id="z1_pcie_cpu2_od2"/> </route>
      <route src="z1_cpu_node_2" dst="z1_accelerator_fr_2"> <link_ctn id="z1_pcie_cpu2_fr2"/> </route>
      <route src="z1_cpu_node_3" dst="z1_accelerator_od_3"> <link_ctn id="z1_pcie_cpu3_od3"/> </route>
      <route src="z1_cpu_node_3" dst="z1_accelerator_fr_3"> <link_ctn id="z1_pcie_cpu3_fr3"/> </route>
      <route src="z1_cpu_node_4" dst="z1_accelerator_od_4"> <link_ctn id="z1_pcie_cpu4_od4"/> </route>
      <route src="z1_cpu_node_4" dst="z1_accelerator_fr_4"> <link_ctn id="z1_pcie_cpu4_fr4"/> </route>
    </zone>

    <!-- Inter-zone link -->
    <link id="bb_z1_core" bandwidth="10Gbps" latency="5ms"/>
    <zoneRoute src="zone_1" dst="core_services" gw_src="z1_router" gw_dst="core_router"> <link_ctn id="bb_z1_core"/> </zoneRoute>

  </zone>
</platform>
